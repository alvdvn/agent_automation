# Environment Configuration

# Figma MCP
FIGMA_ACCESS_TOKEN=your-figma-access-token-here

# n8n (if using external API server)
CURSOR_AGENT_URL=http://localhost:8080
AGENT_API_KEY=your-agent-api-key-here

# Cursor Cloud Agent (for remote execution)
CURSOR_SDK_TOKEN=your-cursor-sdk-token-here
AGENT_MODEL=claude-opus-4

# Flutter Project
FLUTTER_PROJECT_PATH=./figma_to_flutter
GENERATED_CODE_PATH=./figma_to_flutter/lib/generated
